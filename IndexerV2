function Indexer.New(DataParam:IndexerConstructor) -- contstructor 
	
	assert(type(DataParam.Identifier) == "string","Provide A String Identifier")
	assert(type(DataParam.Remote) == "userdata" and DataParam.Remote:IsA('RemoteEvent'),"Provide A Remote Event")
	assert(Indexer.Repository[DataParam.Identifier] == nil,"Identifier In Use")
	
	local self = setmetatable({
		
		Identifier = DataParam.Identifier ; -- string name that will be used
		
		Remote = DataParam.Remote ; -- remote event
		
		FunctionArray = {} -- function storage
		
	},ClassMeta)
	
	Indexer.Repository[self.Identifier] = self
	
	return self
	
end

function Class:Connect(PassedFunc,Order)
	
	assert(type(PassedFunc) == "function", "Provide A Function")
	
	if Order then
		
		assert(type(Order) == "number", "Order Must Be An Int")
		
	end

	local self:Indexer = self
	
	if Order then
		
		table.insert(self.FunctionArray,Order,PassedFunc)
		
	else
		
		table.insert(self.FunctionArray,PassedFunc)
		
	end
	
end

function Class:Recursive(PassedParam:RecursiveType)
	
	local self:Indexer = self
	
	assert(PassedParam::RecursiveType,"Incomplete PassedParam")
	
	assert(PassedParam.PassedData ~= nil and type(PassedParam) == "table" ,"PassedData Required")

	if RunServ:IsServer() then
	
		assert(type(PassedParam.ClientsTo) == "table" and #PassedParam.ClientsTo >= 1,"Player Array With Player/s Expected")
		
		for Index, SupposedPlayer in PassedParam.ClientsTo do
			
			assert(typeof(SupposedPlayer) == "Instance" and SupposedPlayer:IsA("Player"), "Element Is Not A Player")
			
		end
		
		local SendTable = DeepCopy(PassedParam.PassedData)
		
		if #PassedParam.ClientsTo > 1 then
			
			for Index, Player in PassedParam.ClientsTo do
				
				self.Remote:FireClient(Player,SendTable)
				
			end
			
		else
			
			self.Remote:FireClient(PassedParam.ClientsTo[1],SendTable)
			
		end
		
	elseif RunServ:IsClient() then
		
		assert(PassedParam.ClientsTo == nil,"Players Param Not Needed On Client")
		
		local SendTable = DeepCopy(PassedParam.PassedData)
			
		self.Remote:FireServer(SendTable)
		
	end
	
end

if RunServ:IsServer() then
	
	task.spawn(function()
		
		task.wait() -- wait for the next frame so we're passed script read
		
		for Identifier , Object:Indexer in Indexer.Repository  do
			
			if not Indexer.Connections[Object.Remote] then
				
				Indexer.Connections[Object.Remote] = {
					
					ConnectedIdentifiers = {} ;
					
					Connection = Object.Remote.OnServerEvent:Connect(function(SendingPlayer,PassedData)
						print(PassedData)
						print(`Client To Server : {SendingPlayer} : {PassedData}`)
						
					end)
					
				}
				
				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)
				
			elseif Indexer.Connections[Object.Remote] then
				
				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)
				
			end
			
		end
		
	end)
	
elseif RunServ:IsClient() then
	
	task.spawn(function()

		task.wait() -- wait for the next frame so we're passed script read

		for Identifier , Object:Indexer in Indexer.Repository  do

			if not Indexer.Connections[Object.Remote] then

				Indexer.Connections[Object.Remote] = {

					ConnectedIdentifiers = {} ;

					Connection = Object.Remote.OnClientEvent:Connect(function(PassedData)
						
						print(PassedData)
						print(`Client To Server : {PassedData}`)

					end)

				}

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			elseif Indexer.Connections[Object.Remote] then

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			end

		end

	end)
	
end


return Indexer
