function Indexer.New(DataParam:IndexerConstructor) -- contstructor 
	
	assert(type(DataParam.Identifier) == "string","Provide A String Identifier")
	assert(type(DataParam.Remote) == "userdata" and DataParam.Remote:IsA('RemoteEvent'),"Provide A Remote Event")
	assert(Indexer.Repository[string.lower(DataParam.Identifier)] == nil,"Identifier In Use")
	
	local self = setmetatable({
		
		Identifier = string.lower(DataParam.Identifier) ; -- string name that will be used
		
		Remote = DataParam.Remote ; -- remote event
		
		FunctionArray = {} -- function storage
		
	},ClassMeta)
	
	Indexer.Repository[self.Identifier] = self -- set object in obect storage
	
	return self
	
end

function Class:Connect(PassedFunc,Order) -- method of object
	
	assert(type(PassedFunc) == "function", "Provide A Function")
	
	if Order then
		
		assert(type(Order) == "number", "Order Must Be An Int")
		
	end

	local self:Indexer = self
	
	if Order then
		
		table.insert(self.FunctionArray,Order,PassedFunc) -- add it to object's function array at the position 
		
	else
		
		table.insert(self.FunctionArray,PassedFunc) -- else just add it to the array
		
	end
	
end

function Class:Recursive(PassedParam:RecursiveType) -- since each object only has one identifier fires the object's identifer as a param hoping to meet a object with the same identifer on the other replication side
	
	local self:Indexer = self
	
	assert(PassedParam::RecursiveType,"Incomplete PassedParam")
	
	assert(PassedParam.PassedData ~= nil and type(PassedParam.PassedData) == "table" ,"PassedData Required")

	if RunServ:IsServer() then
	
		assert(type(PassedParam.ClientsTo) == "table" and #PassedParam.ClientsTo >= 1,"Player Array With Player/s Expected")
		
		for Index, SupposedPlayer in PassedParam.ClientsTo do
			
			assert(typeof(SupposedPlayer) == "Instance" and SupposedPlayer:IsA("Player"), "Element Is Not A Player")
			
		end
		
		if #PassedParam.ClientsTo > 1 then
			
			for Index, Player in PassedParam.ClientsTo do
				
				self.Remote:FireClient(Player,{

					Identifier  = self.Identifier ;

					PassedData = PassedParam.PassedData


				})
				
			end
			
		else
			
			self.Remote:FireClient(PassedParam.ClientsTo[1],{
				
				Identifier  = self.Identifier ;
				
				PassedData = PassedParam.PassedData
				

			})
			
		end
		
	elseif RunServ:IsClient() then
		
		assert(PassedParam.ClientsTo == nil,"Players Param Not Needed On Client")

		self.Remote:FireServer({

			Identifier  = self.Identifier ;

			PassedData = PassedParam.PassedData


		})
		
	end
	
end

function Indexer.Fire(PassedParam:FireType)  -- differs from the recursive function as that doesnt take an indentifer and is meant to go by that classes identifier as this can do any identifer

	assert(PassedParam::FireType,"Incomplete PassedParam")

	assert(type(PassedParam.Remote) == "userdata" and PassedParam.Remote:IsA('RemoteEvent'), "RemoteEvent Required")

	assert(PassedParam.PassedData ~= nil and type(PassedParam.PassedData) == "table" ,"PassedData Required")
	
	assert(PassedParam.Identifier ~=nil,"Identifer Required")

	if RunServ:IsServer() then

		assert(type(PassedParam.ClientsTo) == "table" and #PassedParam.ClientsTo >= 1,"Player Array With Player/s Expected")

		for Index, SupposedPlayer in PassedParam.ClientsTo do

			assert(typeof(SupposedPlayer) == "Instance" and SupposedPlayer:IsA("Player"), "Element Is Not A Player")

		end

		if #PassedParam.ClientsTo > 1 then

			for Index, Player in PassedParam.ClientsTo do

				PassedParam.Remote:FireClient(Player,{

					Identifier  = PassedParam.Identifier ;

					PassedData = PassedParam.PassedData

				})

			end

		else

			PassedParam.Remote:FireClient(PassedParam.ClientsTo[1],{

				Identifier  = PassedParam.Identifier ;

				PassedData = PassedParam.PassedData

			})

		end

	elseif RunServ:IsClient() then

		assert(PassedParam.ClientsTo == nil,"Players Param Not Needed On Client")
		
		PassedParam.Remote:FireServer({

			Identifier  = PassedParam.Identifier ;

			PassedData = PassedParam.PassedData

		})

	end
	
end

