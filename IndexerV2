--[[

Networking Module

Indexer.New -> Creates Object 
	
	Requires These Params : {
	
		Remote ; the remove event its linked too
		
		Identifer ; the string identifer, this is how the remote events identify the function/s to call
	
		}
	
Object:Connect() -> pass a function through the connect parameter, these functions are tied to the objects identifer, params to the function varies by server and client
the server params will be (ClientThatSent,PassedData) while the client will just be (PassedData)

	Requires These Params : {
	
		function()
		
	Additonal Params :
	
		ArrayPos ; where in the function array will be placed // number
		
	}

Object:Recursive() -> send to the client/server with the objects identifer, will only work the objects identifer ie both the client and the server have the "Bleh" identifer it will only run
assiocated bleh functions // requires both "Bleh" on the client and sever 
	
	ServerParam : {
	
		ClientsTo = {Player/s} provide players in an array format 
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}

	ClientParam : {
	
		PassedData = {} // whatever data you want to pass along the wire, notice it doesnt have the ClientsTo
	
	}
	
Indexer.Fire() -> fires a identifer through a remote with passed data, if these are on the other side/valid indexer objects assiocated functions will be ran unlike Object:Recursive you provide an identifier and remote event
	
	ServerParam : {
	
		Remote : remote event in which your passing information along the wire
		
		Identifer = string identifier of object
	
		ClientsTo = {Player/s} provide players in an array format 
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}
	
	ClientParam : {
	
		Remote : remote event in which your passing information along the wire
		
		Identifer = string identifier of object
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}

]]


local RunServ = game:GetService('RunService')

local Class = {}
local ClassMeta = {__index=Class}

export type IndexerConstructor = {
	
	Remote : RemoteEvent ;
	
	Identifier : string
	
}

export type Indexer = {

	Remote : RemoteEvent ;

	Identifier : string ;

	FunctionArray : {} ;

}

export type RecursiveType = {
	
	ClientsTo : {Player} ;
	
	PassedData : {any} ;
	
}

export type FireType = {
	
	Remote : RemoteEvent ;
	
	Identifier : string ;
	
	ClientsTo : {Player} ;
	
	PassedData : {any}
	
}

export type BackForth = {
	
	Identifier : string ;
	
	PassedData : {any} ;
	
}


local Indexer = {
	
	Repository = {} ; -- object storage
	
	Connections = {} ; -- remote event script connection storage
	
}


local function RunTimeEvents(GetSignalType,DefineArgs) -- both params are created functions, GetSignalType returns the remote type giving the remote as a param
	-- DefineArgs is given as ... taking advantage of the multi length we can pass back multiple things in the func return
	
	task.spawn(function()

		task.wait() -- wait for the next frame so we're passed script read

		for Identifier , Object:Indexer in Indexer.Repository  do

			if not Indexer.Connections[Object.Remote] then

				Indexer.Connections[Object.Remote] = {

					ConnectedIdentifiers = {} ;

					Connection = GetSignalType(Object.Remote):Connect(function(...)
						
						local IfSendPlayer, PassedData = DefineArgs(...)
						
						assert(type(PassedData) == "table" ,"PassedData Required")
						assert(type(PassedData.Identifier) == "string","Provide A String Identifier")
						assert(type(PassedData.PassedData) == "table" ,"PassedData Required")
						
						
						if Indexer.Repository[PassedData.Identifier] and #Indexer.Repository[PassedData.Identifier].FunctionArray > 0 then
						
							if IfSendPlayer then
								
								for Index, ConnectedFunction in Indexer.Repository[PassedData.Identifier].FunctionArray do 

									ConnectedFunction(IfSendPlayer,PassedData.PassedData)

								end
								
							else
								
								for Index, ConnectedFunction in Indexer.Repository[PassedData.Identifier].FunctionArray do 

									ConnectedFunction(PassedData.PassedData)

								end
								
							end

						end

					end) ;

				}

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			elseif Indexer.Connections[Object.Remote] then

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			end

		end

	end)
	
end


