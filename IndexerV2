Networking Module

Indexer.New -> Creates Object 
	
	Requires These Params : {
	
		Remote ; the remove event its linked too
		
		Identifer ; the string identifer, this is how the remote events identify the function/s to call
	
		}
	
Object:Connect() -> pass a function through the connect parameter, these functions are tied to the objects identifer, params to the function varies by server and client
the server params will be (ClientThatSent,PassedData) while the client will just be (PassedData)

	Requires These Params : {
	
		function()
		
	Additonal Params :
	
		ArrayPos ; where in the function array will be placed // number
		
	}

Object:Recursive() -> send to the client/server with the objects identifer, will only work the objects identifer ie both the client and the server have the "Bleh" identifer it will only run
assiocated bleh functions // requires both "Bleh" on the client and sever 
	
	ServerParam : {
	
		ClientsTo = {Player/s} provide players in an array format 
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}

	ClientParam : {
	
		PassedData = {} // whatever data you want to pass along the wire, notice it doesnt have the ClientsTo
	
	}
	
Indexer.Fire() -> fires a identifer through a remote with passed data, if these are on the other side/valid indexer objects assiocated functions will be ran unlike Object:Recursive you provide an identifier and remote event
	
	ServerParam : {
	
		Remote : remote event in which your passing information along the wire
		
		Identifer = string identifier of object
	
		ClientsTo = {Player/s} provide players in an array format 
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}
	
	ClientParam : {
	
		Remote : remote event in which your passing information along the wire
		
		Identifer = string identifier of object
		
		PassedData = {} // whatever data you want to pass along the wire 
	
	}

]]


local RunServ = game:GetService('RunService')

local Class = {}
local ClassMeta = {__index=Class}

export type IndexerConstructor = {
	
	Remote : RemoteEvent ;
	
	Identifier : string
	
}

export type Connection = {
	
	ConnectedIdentifiers : {string} ;
	
	IdentifierConnection : RBXScriptConnection ;
	
}

export type Indexer = {

	Remote : RemoteEvent ;

	Identifier : string ;

	FunctionArray : { (any) -> () }

}

export type RecursiveType = {
	
	ClientsTo : {Player} ;
	
	PassedData : {any} ;
	
}

export type FireType = {
	
	Remote : RemoteEvent ;
	
	Identifier : string ;
	
	ClientsTo : {Player} ;
	
	PassedData : {any}
	
}

export type BackForth = {
	
	Identifier : string ;
	
	PassedData : {any} ;
	
}

local Indexer = {
	
	Repository = {} ; -- object storage
	
	Connections = {} ; -- remote event script connection storage
	
}

