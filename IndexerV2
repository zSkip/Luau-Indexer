if RunServ:IsServer() then -- done on runtime when module is read
	
	task.spawn(function() -- since all added module data is also added when read we have to wait for the next frame to guarantee its been read
		
		task.wait() -- wait for the next frame so we're passed script read
		
		for Identifier , Object:Indexer in Indexer.Repository  do
			
			if not Indexer.Connections[Object.Remote] then -- if remote event does have a connect
				
				Indexer.Connections[Object.Remote] = {
					
					ConnectedIdentifiers = {} ;
					
					Connection = Object.Remote.OnServerEvent:Connect(function(SendingPlayer,PassedData:BackForth)
						
						if Indexer.Repository[PassedData.Identifier] then -- if object 
							
							if #Indexer.Repository[PassedData.Identifier].FunctionArray > 0 then -- if it has atleast a function in the function array
								
								for Index, ConnectedFunction in Indexer.Repository[PassedData.Identifier].FunctionArray do 
									
									ConnectedFunction(SendingPlayer,PassedData.PassedData)
									
								end
									
							end
							
						end
						
					end) ;
					
				}
				
				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier) -- add to connections to make the check above true // prevents a single remote event having more than 1 script connection
				
			elseif Indexer.Connections[Object.Remote] then
				
				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier) -- else add thee identifer under the connect
				
			end
			
		end
		
	end)
	
elseif RunServ:IsClient() then
	
	task.spawn(function()

		task.wait() -- wait for the next frame so we're passed script read

		for Identifier , Object:Indexer in Indexer.Repository  do

			if not Indexer.Connections[Object.Remote] then

				Indexer.Connections[Object.Remote] = {

					ConnectedIdentifiers = {} ;

					Connection = Object.Remote.OnClientEvent:Connect(function(PassedData:BackForth)

						if Indexer.Repository[PassedData.Identifier] then

							if #Indexer.Repository[PassedData.Identifier].FunctionArray > 0 then

								for Index, ConnectedFunction in Indexer.Repository[PassedData.Identifier].FunctionArray do 

									ConnectedFunction(PassedData.PassedData)

								end

							end

						end

					end) ;

				}

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			elseif Indexer.Connections[Object.Remote] then

				table.insert(Indexer.Connections[Object.Remote].ConnectedIdentifiers,Object.Identifier)

			end

		end

	end)
	
end

return Indexer
