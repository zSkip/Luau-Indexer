
local RunServ = game:GetService('RunService')

local function DeepCopy(original)
	local copy = {}
	for k, v in original do
		if typeof(v) == "table" then
			v = DeepCopy(v)
		end
		copy[k] = v
	end
	return copy
end   

local Class = {}
local ClassMeta = {__index=Class}

export type IndexerConstructor = {
	
	Remote : RemoteEvent ;
	
	Identifier : string
	
}

export type Connection = {
	
	ConnectedIdentifiers : {string} ;
	
	IdentifierConnection : RBXScriptConnection ;
	
}

export type Indexer = {

	Remote : RemoteEvent ;

	Identifier : string ;

	FunctionArray : { (any) -> () }

}

export type RecursiveType = {
	
	ClientsTo : {Player} ;
	
	PassedData : {any} ;
	
}

local Indexer = {
	
	Repository = {} ; -- object storage
	
	Connections = {} ; -- remote event script connection storage
	
}

